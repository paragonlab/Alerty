EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# RevenueCat — claves públicas del SDK (solo mobile; Plus en web usa Stripe).
# Si se dejan vacías, el paywall de mobile mostrará "pagos no disponibles".
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_YOUR_IOS_KEY
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_YOUR_ANDROID_KEY

# Nota: los secrets de las edge functions de Stripe/RevenueCat NO van aquí.
# Se configuran con `supabase secrets set` (ver MONETIZATION.md §2.6).
