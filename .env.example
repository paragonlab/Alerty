EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Google Maps — obligatorio en Android nativo (iOS usa Apple Maps; web cae a Leaflet).
# También habilita showsTraffic nativo (capa de circulación opt-in).
# EXPO_PUBLIC_GOOGLE_MAPS_KEY=AIza...

# TomTom — capa de circulación en web (Leaflet tile overlay). Sin key, el toggle no aparece
# en web (salvo EXPO_PUBLIC_TRAFFIC_MOCK=1 para demos/screenshots).
# Alta: https://developer.tomtom.com/ → API key con Traffic Map / Map Display.
# Vercel: Project → Settings → Environment Variables → EXPO_PUBLIC_TOMTOM_KEY
# Expo (EAS): eas.json / secrets o .env en el build.
# EXPO_PUBLIC_TOMTOM_KEY=
# EXPO_PUBLIC_TRAFFIC_LAYER=1
# EXPO_PUBLIC_TRAFFIC_MOCK=0

# Modo viaje (Antes de salir · Culiacán ↔ Mazatlán). Default on; 0 para ocultar.
# EXPO_PUBLIC_TRAVEL_MODE=1

# RevenueCat — claves públicas del SDK (solo mobile; Plus en web usa Stripe).
# Si se dejan vacías, el paywall de mobile mostrará "pagos no disponibles".
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_YOUR_IOS_KEY
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_YOUR_ANDROID_KEY

# Nota: los secrets de las edge functions de Stripe/RevenueCat/X NO van aquí.
# Se configuran con `supabase secrets set` (ver MONETIZATION.md §2.6 y docs/COMMUNITY_X.md).
#
# Comunidad X (Twitter) — solo en Supabase secrets, nunca en el cliente:
#   supabase secrets set X_BEARER_TOKEN=YOUR_X_API_BEARER_TOKEN
#   supabase secrets set X_ALLOWLIST=LineaDirectaMX:medio,SSPSinaloa:oficial
#   supabase secrets set NEWS_RSS_FEEDS=https://...,https://...
# Sin X_BEARER_TOKEN, sync-x-community responde mode=demo, pero la UI no muestra seeds.
# Cron cada 10 min: Vault project_url + publishable_key (docs/COMMUNITY_X.md). No pegar service_role aquí.
# Ver docs/COMMUNITY_X.md (allowlist, geo, RSS).