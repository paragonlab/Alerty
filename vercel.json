{
  "installCommand": "npm install",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "functions": {
    "api/og.js": {
      "includeFiles": "api/fonts/**"
    },
    "api/p.js": {
      "includeFiles": "api/fonts/**"
    }
  },
  "routes": [
    {
      "src": "/privacy",
      "dest": "/privacy.html"
    },
    {
      "src": "/terms",
      "dest": "/terms.html"
    },
    {
      "src": "/terminos",
      "dest": "/terms.html"
    },
    {
      "src": "/api/og",
      "dest": "/api/og"
    },
    {
      "src": "/p/(?<id>[^/]+)",
      "dest": "/api/p?id=$id"
    },
    {
      "src": "/v/(?<id>[^/]+)",
      "dest": "/api/p?id=$id&surface=video"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
